# ─── Backup files (contain live DB data — never commit) ──────────────────────
backend/backups/

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ─── Secrets ──────────────────────────────────────────────────────────────────
# .env.{profile} files contain only ${PLACEHOLDER} markers — safe to commit.
# Real values live in .secrets.{profile} vault files, which are gitignored.
#
# Pattern overview:
#   config/secrets/dev/.env.dev       ← committed (placeholders only, safe)
#   config/secrets/dev/.secrets.dev   ← gitignored (real values)
#
# Old-style root .env files (not used in this project — kept as safety net)
.env
.env.local
.env.production
.env.*.local

# Firebase service account key (if downloaded as JSON)
serviceAccountKey.json
*serviceAccount*.json

# ─── Vite cache ───────────────────────────────────────────────────────────────
.vite/
frontend/.vite/

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vault files with real credentials — never commit
config/**/secrets/*/.secrets.*
config/**/secrets/*/*.json

*.claude/



