# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ─── Secrets ──────────────────────────────────────────────────────────────────
# The .env.* files in config/secrets/ contain placeholder values and are
# committed so the team knows what vars are required.
# Once you fill in real credentials, add your profile file to a local
# .gitignore_personal or use git-crypt / a secrets manager.
#
# Files you should NEVER commit with real values:
#   config/secrets/dev/.env.dev
#   config/secrets/prod/.env.prod
#   config/secrets/staging/.env.staging
#
# Old-style root .env files (not used in this project — kept as safety net)
.env
.env.local
.env.production
.env.*.local

# Firebase service account key (if downloaded as JSON)
serviceAccountKey.json
*serviceAccount*.json

# ─── Vite cache ───────────────────────────────────────────────────────────────
.vite/
frontend/.vite/

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

config/secrets/*/.env.*
config/secrets/*/.json