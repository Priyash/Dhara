# ─────────────────────────────────────────────────────────────────────────────
# PROFILE: dev  |  safe to commit — no real secrets here
#
# ${PLACEHOLDER} values are resolved from config/secrets/dev/.secrets.dev
# at startup. Add your real credentials there (it is gitignored).
#
# On Render / Vercel, env vars are injected by the platform — no vault needed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=${MONGODB_URI}

# Firebase Admin — service account encoded as base64
# Generate: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=${FIREBASE_SERVICE_ACCOUNT_BASE64}

# Comma-separated admin emails (fallback when Firebase custom claim is not set)
ADMIN_EMAILS=${ADMIN_EMAILS}

# Resend — transactional email for creator/submission notifications
# Get a free API key at resend.com (3,000 emails/month free)
# Leave blank locally to skip emails silently during development
RESEND_API_KEY=${RESEND_API_KEY}
# Must be a verified sender in your Resend dashboard → Domains
RESEND_FROM=${RESEND_FROM}

# Razorpay — use TEST keys locally (dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=${RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=${RAZORPAY_WEBHOOK_SECRET}

# Bunny Stream — app.bunny.net → Stream → Your Library
BUNNY_STREAM_LIBRARY_ID=${BUNNY_STREAM_LIBRARY_ID}
BUNNY_STREAM_API_KEY=${BUNNY_STREAM_API_KEY}
# Pull zone hostname without https://, e.g. vz-abc123.b-cdn.net
BUNNY_CDN_PULL_ZONE=${BUNNY_CDN_PULL_ZONE}
# Token Authentication key — enable on the pull zone in Bunny dashboard
BUNNY_CDN_TOKEN_AUTH_KEY=${BUNNY_CDN_TOKEN_AUTH_KEY}
# Slug of the Bunny Stream collection dedicated to reel uploads.
# Must match the slug that Admin → Uploads → Sync from Bunny creates in MongoDB.
# Create a collection named "dhara-reels" in your Bunny library first.
REEL_COLLECTION_SLUG=dhara-reels

# Cloudinary — cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
CLOUDINARY_API_KEY=${CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=${CLOUDINARY_API_SECRET}

# ── Frontend (Vite exposes only VITE_ vars to the browser) ───────────────────
VITE_API_URL=http://localhost:4000
# Bunny Stream library ID — used by admin panel to construct reel preview iframes
VITE_BUNNY_STREAM_LIBRARY_ID=${BUNNY_STREAM_LIBRARY_ID}

# Firebase Web App — Firebase Console → Project Settings → Your apps → Web
VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY}
VITE_FIREBASE_AUTH_DOMAIN=${VITE_FIREBASE_AUTH_DOMAIN}
VITE_FIREBASE_PROJECT_ID=${VITE_FIREBASE_PROJECT_ID}
VITE_FIREBASE_STORAGE_BUCKET=${VITE_FIREBASE_STORAGE_BUCKET}
VITE_FIREBASE_MESSAGING_SENDER_ID=${VITE_FIREBASE_MESSAGING_SENDER_ID}
VITE_FIREBASE_APP_ID=${VITE_FIREBASE_APP_ID}

# Cloudinary — public upload preset (browser-side uploads)
VITE_CLOUDINARY_CLOUD_NAME=${VITE_CLOUDINARY_CLOUD_NAME}
VITE_CLOUDINARY_UPLOAD_PRESET=${VITE_CLOUDINARY_UPLOAD_PRESET}


REDIS_URL=rediss://default:gQAAAAAAAlNMAAIgcDJiZjhiN2RhOWQ5ZjA0MmM0ODYyZjRjZDQxOGMxYTQ1NA@epic-snipe-152396.upstash.io:6379
# Scheduled Internet Archive discovery — review-only, never imports automatically.
# Surfaces candidates in Admin → Archive Import → "Discovered for review".
ARCHIVE_DISCOVERY_ENABLED=true
ARCHIVE_DISCOVERY_LANGUAGES=Bengali
ARCHIVE_DISCOVERY_INTERVAL_H=24

