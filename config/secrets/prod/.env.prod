# ─────────────────────────────────────────────────────────────────────────────
# PROFILE: prod  |  safe to commit — no real secrets here
# On Render / Vercel, all vars below are set as platform environment variables.
# No vault file is needed in production — the platform injects them directly.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app

MONGODB_URI=${MONGODB_URI}

FIREBASE_SERVICE_ACCOUNT_BASE64=${FIREBASE_SERVICE_ACCOUNT_BASE64}

ADMIN_EMAILS=${ADMIN_EMAILS}

# Razorpay — use LIVE keys in prod (rzp_live_*)
RAZORPAY_KEY_ID=${RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=${RAZORPAY_WEBHOOK_SECRET}

BUNNY_STREAM_LIBRARY_ID=${BUNNY_STREAM_LIBRARY_ID}
BUNNY_STREAM_API_KEY=${BUNNY_STREAM_API_KEY}
BUNNY_CDN_PULL_ZONE=${BUNNY_CDN_PULL_ZONE}
# Required in prod — enable Token Auth on the pull zone in Bunny dashboard
BUNNY_CDN_TOKEN_AUTH_KEY=${BUNNY_CDN_TOKEN_AUTH_KEY}
# Slug of the Bunny Stream collection for reels — must exist in MongoDB after Admin → Sync from Bunny
REEL_COLLECTION_SLUG=dhara-reels

CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
CLOUDINARY_API_KEY=${CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=${CLOUDINARY_API_SECRET}

VITE_API_URL=https://dhara-api.onrender.com

VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY}
VITE_FIREBASE_AUTH_DOMAIN=${VITE_FIREBASE_AUTH_DOMAIN}
VITE_FIREBASE_PROJECT_ID=${VITE_FIREBASE_PROJECT_ID}
VITE_FIREBASE_STORAGE_BUCKET=${VITE_FIREBASE_STORAGE_BUCKET}
VITE_FIREBASE_MESSAGING_SENDER_ID=${VITE_FIREBASE_MESSAGING_SENDER_ID}
VITE_FIREBASE_APP_ID=${VITE_FIREBASE_APP_ID}

VITE_CLOUDINARY_CLOUD_NAME=${VITE_CLOUDINARY_CLOUD_NAME}
VITE_CLOUDINARY_UPLOAD_PRESET=${VITE_CLOUDINARY_UPLOAD_PRESET}
